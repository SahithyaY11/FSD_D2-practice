<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>

<body>

<h1><%= title %></h1>

<% if (error) { %>
    <h3><%= error %></h3>
<% } %>

<% if (user) { %>
    <h3>Welcome <%= user %>!</h3>
<% } %>

<form action="/register" method="POST">

    <label>Username:</label>
    <input type="text" name="username">

    <br><br>

    <label>Age:</label>
    <input type="number" name="age">

    <br><br>

    <button type="submit">Register</button>

</form>

</body>
</html>